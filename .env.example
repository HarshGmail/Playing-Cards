MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/playing-cards?retryWrites=true&w=majority
JWT_SECRET=your-secret-key-min-32-chars-long-for-production
NODE_ENV=development

# Cloudinary — profile picture storage. Copy these from the "Product Environment
# Credentials" panel on your Cloudinary dashboard. Server-only: never prefix
# these with NEXT_PUBLIC_, the API secret must not reach the browser.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# Web push. Generate a key pair with `npx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must equal VAPID_PUBLIC_KEY. VAPID_SUBJECT is
# optional and defaults to mailto:noreply@playingcards.app.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_SUBJECT=mailto:you@example.com
